{
  "name": "leetsee",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pyodide.mjs",
    "traces": "tsx scripts/build-traces.ts",
    "predev": "npm run -s traces",
    "dev": "vite",
    "prebuild": "npm run -s traces",
    "build": "tsc --noEmit && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "trace": "PYTHONHASHSEED=0 python3 engine/tracer/tracer.py",
    "e2e": "playwright test",
    "draft": "tsx scripts/draft.ts",
    "promote": "tsx scripts/promote.ts"
  },
  "dependencies": {
    "pyodide": "314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
